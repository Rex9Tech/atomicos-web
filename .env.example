# ==============================================================================
# 👑 REXONE WEB — APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Organized strictly by operational priority and architectural tiers:
#
#   🟢 TIER 1: CRITICAL RUNTIME & APIS (Required to run Vite dev server & connect to API)
#   🟡 TIER 2: BRANDING & PUBLIC METADATA (App name, support email, & domain presets)
#   🟠 TIER 3: AUTHENTICATION & THIRD-PARTY SERVICES (Google OAuth)
#   🟣 TIER 4: OBSERVABILITY & ANALYTICS (Firebase Analytics web stream)
#   ⚪ TIER 5: MEDIA LIMITS & DEV DOCKER TUNING (Upload boundaries & port mappings)
# ==============================================================================


# ==============================================================================
# 🟢 TIER 1: CRITICAL RUNTIME & APIS
# ==============================================================================

NODE_ENV=development
PORT=4000
VITE_PORT=4000

# Server API & WebSocket Base URLs (No trailing slash)
VITE_REACT_APP_SERVER_BASE_URL=http://localhost:3000
VITE_REACT_APP_SERVER_WS_BASE_URL=ws://localhost:3000
VITE_REACT_APP_CLIENT_BASE_URL=http://localhost:4000


# ==============================================================================
# 🟡 TIER 2: BRANDING & PUBLIC METADATA
# ==============================================================================

VITE_REACT_APP_NAME=AtomicOS
VITE_REACT_APP_FROM_EMAIL=support@atomicos.io

# ------------------------------------------------------------------------------
# Domain Configuration Presets (supports ANY TLD: .com, .io, .ai, .me, etc.)
# ------------------------------------------------------------------------------
#
# Production Tier (e.g. RexOne):
#   VITE_REACT_APP_CLIENT_BASE_URL=https://atomicos.io
#   VITE_REACT_APP_SERVER_BASE_URL=https://core.atomicos.io
#   VITE_REACT_APP_SERVER_WS_BASE_URL=wss://core.atomicos.io
#
# UAT Tier:
#   VITE_REACT_APP_CLIENT_BASE_URL=https://uat.rexone.com
#   VITE_REACT_APP_SERVER_BASE_URL=https://uat.core.atomicos.io
#   VITE_REACT_APP_SERVER_WS_BASE_URL=wss://uat.core.atomicos.io
#
# Dev Tier:
#   VITE_REACT_APP_CLIENT_BASE_URL=https://dev.rexone.com
#   VITE_REACT_APP_SERVER_BASE_URL=https://dev.core.atomicos.io
#   VITE_REACT_APP_SERVER_WS_BASE_URL=wss://dev.core.atomicos.io


# ==============================================================================
# 🟠 TIER 3: AUTHENTICATION & THIRD-PARTY SERVICES
# ==============================================================================

VITE_REACT_APP_GOOGLE_CLIENT_ID=changeme_google_client_id.apps.googleusercontent.com
VITE_REACT_APP_GOOGLE_CLIENT_SECRET=changeme_google_client_secret


# ==============================================================================
# 🟣 TIER 4: OBSERVABILITY & ANALYTICS
# ==============================================================================

# Firebase Analytics Web Stream (Public client identifiers, not service secrets)
VITE_FIREBASE_API_KEY=changeme_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=changeme.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=changeme_firebase_project_id
VITE_FIREBASE_APP_ID=1:123456789012:web:changeme
VITE_FIREBASE_MEASUREMENT_ID=G-CHANGEME


# ==============================================================================
# ⚪ TIER 5: MEDIA LIMITS & DEV DOCKER TUNING
# ==============================================================================

# Media Upload Boundaries
VITE_MEDIA_MAX_NON_VIDEO_SIZE_MB=10
VITE_MEDIA_MAX_VIDEO_SIZE_MB=300
VITE_MEDIA_MAX_FILE_COUNT=30

# Dev Docker & Container Bindings
VITE_REACT_APP_PORT_MAP=4000:4000
VITE_REACT_APP_DOCKERFILE=Dockerfile.dev

# Media upload boundaries
VITE_MEDIA_MAX_NON_VIDEO_SIZE_MB=10
VITE_MEDIA_MAX_VIDEO_SIZE_MB=100
VITE_MEDIA_MAX_FILE_COUNT=20
